{
	"name": "@vanilla-bean/oxject",
	"version": "1.0.0",
	"description": "Reactive state container built on the platform's own EventTarget. Property access and assignment look like a plain object; the reactivity is invisible.",
	"type": "module",
	"main": "index.js",
	"types": "index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		}
	},
	"files": [
		"src/CleanupManager.js",
		"src/derive.js",
		"src/ErrorHandler.js",
		"src/Oxject.js",
		"src/TrackingContext.js",
		"src/utils.js",
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"reactive",
		"state",
		"observable",
		"proxy",
		"eventtarget",
		"framework-agnostic",
		"zero-dependency"
	],
	"license": "MIT",
	"author": "justfatlard (https://github.com/fatlard1993)",
	"repository": {
		"type": "git",
		"url": "https://github.com/fatlard1993/oxject"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"test": "bun test",
		"test:watch": "bun test --watch",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write . | grep -q unchanged",
		"version": "npm version",
		"prepublishOnly": "bun test"
	},
	"devDependencies": {
		"@eslint/js": "^9",
		"bun-types": "^1.0.0",
		"eslint": "^9",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.0",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-unicorn": "^64.0.0",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.0.0",
		"prettier": "^3.0.0"
	}
}
